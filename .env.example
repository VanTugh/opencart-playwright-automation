# OpenCart Automation Testing Framework - Environment Configuration
# Copy this file to .env and modify values as needed

# OpenCart URL
OPENCART_URL=http://localhost/opencart_test/upload/

# Browser Settings
BROWSER_HEADLESS=False
BROWSER_TYPE=chromium

# Timeout Settings (in milliseconds)
NAVIGATION_TIMEOUT=60000
ACTION_TIMEOUT=30000
ELEMENT_TIMEOUT=10000

# Screenshot Settings
SCREENSHOT_ON_FAILURE=True
SCREENSHOT_ON_SUCCESS=False
SCREENSHOT_DIR=failures

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=logs

# Report Settings
REPORT_DIR=reports

# Parallel Execution
NUM_WORKERS=1

# Test Data File
TEST_DATA_FILE=OpenCart_203_TestCases_Final.json

# Retry Settings
MAX_RETRIES=0
RETRY_DELAY=1

# Test User Credentials
TEST_USER_EMAIL=shin@test.com
TEST_USER_PASSWORD=123456
TEST_USER_NEW_EMAIL=new@test.com

